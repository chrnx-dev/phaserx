{
  "name": "phaserx",
  "version": "26.7.0-alpha.0",
  "description": "Decorator-powered ECS framework on top of Phaser 4",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capacity": {
      "types": "./dist/capacity.d.ts",
      "import": "./dist/capacity.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "phaser": "^4.0.0"
  },
  "dependencies": {
    "bitecs": "0.4.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "phaser": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
