{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests", "demo"]
}
